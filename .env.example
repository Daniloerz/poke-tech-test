# Copy this file to .env and set real values. .env is ignored by Git.
# Docker Compose reads .env; the backend only sees the environment variables Compose passes to it.

# PostgreSQL
POSTGRES_DB=pokemon
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=change-me

# JWT (user-auth). At least 32 characters. Generate one, for example: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-value-of-at-least-32-characters
JWT_EXPIRATION=1h

# Host ports (5432 and 6379 are often taken by other local containers)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8080
